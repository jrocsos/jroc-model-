$LLMClient = @'
/* src/llm/LLMClient.hf.ts */
import fetch from 'node-fetch';
import { LLMModel } from '../models/ModelTypes';
import { HF_MODEL_REGISTRY } from '../models/ModelRegistry.hf';

export async function callLLM(model: LLMModel, prompt: string): Promise<{ output: string; meta?: any }> {
  try {
    if ((model as any).provider === 'local-hf') {
      return { output: await callLocalHF(model, prompt) };
    }
    if ((model as any).provider === 'huggingface') {
      return { output: await callHuggingFace(model, prompt) };
    }
    const fallback = HF_MODEL_REGISTRY.find(m => m.isLocal && m.provider === 'local-hf');
    if (fallback) return { output: await callLocalHF(fallback, prompt) };
    throw new Error('No available model provider');
  } catch (err) {
    throw err;
  }
}

async function callHuggingFace(model: LLMModel, prompt: string): Promise<string> {
  const apiKey = process.env.HF_API_KEY;
  if (!apiKey) throw new Error('HF_API_KEY not set');
  const repo = (model as any).hf_repo ?? model.id;
  const url = `https://api-inference.huggingface.co/models/${encodeURIComponent(repo)}`;
  const res = await fetch(url, {
    method: 'POST',
    headers: { Authorization: `Bearer ${apiKey}`, 'Content-Type': 'application/json' },
    body: JSON.stringify({ inputs: prompt, parameters: { max_new_tokens: model.maxOutputTokens ?? 512 } })
  });
  if (!res.ok) {
    const text = await res.text();
    throw new Error(`HuggingFace error: ${res.status} ${text}`);
  }
  const json = await res.json();
  if (Array.isArray(json) && json[0]?.generated_text) return json[0].generated_text;
  if (json.generated_text) return json.generated_text;
  if (json.error) throw new Error(`HF inference error: ${json.error}`);
  return JSON.stringify(json);
}

async function callLocalHF(model: LLMModel, prompt: string): Promise<string> {
  const repo = (model as any).hf_repo ?? model.id;
  const url = process.env.LOCAL_HF_URL || 'http://localhost:8000/generate';
  const res = await fetch(url, {
    method: 'POST',
    headers: { 'Content-Type': 'application/json', 'x-api-key': process.env.LOCAL_HF_API_KEY ?? '' },
    body: JSON.stringify({ model: repo, prompt, max_new_tokens: model.maxOutputTokens ?? 512 })
  });
  if (!res.ok) {
    const text = await res.text();
    throw new Error(`Local HF error: ${res.status} ${text}`);
  }
  const json = await res.json();
  return json.output ?? JSON.stringify(json);
}
'@

$LocalServer = @'
# local_hf_server.py
from fastapi import FastAPI, HTTPException, Request
from pydantic import BaseModel
from typing import Optional
import uvicorn
import os
import torch
from transformers import AutoTokenizer, AutoModelForCausalLM, pipeline

app = FastAPI()
MODEL_CACHE = {}

class GenRequest(BaseModel):
    model: str
    prompt: str
    max_new_tokens: Optional[int] = 512

def load_model(model_name: str):
    if model_name in MODEL_CACHE:
        return MODEL_CACHE[model_name]
    device = 0 if torch.cuda.is_available() else -1
    tokenizer = AutoTokenizer.from_pretrained(model_name, use_fast=True)
    model = AutoModelForCausalLM.from_pretrained(
        model_name,
        device_map="auto" if torch.cuda.is_available() else None,
        torch_dtype=torch.float16 if torch.cuda.is_available() else torch.float32
    )
    gen = pipeline("text-generation", model=model, tokenizer=tokenizer, device=device if device >= 0 else -1)
    MODEL_CACHE[model_name] = gen
    return gen

@app.post("/generate")
async def generate(req: GenRequest, request: Request):
    api_key = os.environ.get("LOCAL_HF_API_KEY")
    if api_key:
        header_key = request.headers.get("x-api-key")
        if header_key != api_key:
            raise HTTPException(status_code=401, detail="Unauthorized")
    try:
        gen = load_model(req.model)
        out = gen(req.prompt, max_new_tokens=req.max_new_tokens, do_sample=False, return_full_text=False)
        text = out[0]['generated_text'] if isinstance(out, list) else out.get('generated_text', str(out))
        return {"output": text}
    except Exception as e:
        raise HTTPException(status_code=500, detail=str(e))

if __name__ == "__main__":
    uvicorn.run("local_hf_server:app", host="0.0.0.0", port=int(os.environ.get("LOCAL_HF_PORT", 8000)), workers=1)
'@

